{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "x-migrate",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-24",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "single-page-application"
  }
}
