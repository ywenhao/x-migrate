{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "x-migrate",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-24",
  "build": {
    "command": "pnpm run build",
  },
  "previews": {},
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "not_found_handling": "single-page-application",
  },
}
