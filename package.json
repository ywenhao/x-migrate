{
  "name": "x-migrate",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "把 X.com（Twitter）的关注与收藏迁移到另一个账号，可选移除旧账号的关注/收藏。使用 Vue Vapor 构建。",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "test": "node --experimental-transform-types --test test/migration.test.mjs"
  },
  "dependencies": {
    "linkedom": "^0.18.13",
    "vue": "3.6.0-rc.9",
    "x-client-transaction-id": "0.3.1"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@vitejs/plugin-vue": "^6.0.9",
    "typescript": "^5.6.3",
    "undici": "^8.11.0",
    "vite": "^8.3.0",
    "vue-tsc": "^3.1.4"
  }
}
